{
  "name": "apply4me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:chrome": "TARGET_BROWSER=chrome vite build",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "dev:firefox": "web-ext run --source-dir dist/ --target firefox-desktop",
    "build:me": "rm -rf dist && TARGET_BROWSER=chrome A4M_SEED=\"${A4M_SEED:?set A4M_SEED}\" vite build && rm -rf \"${A4M_OUT:?set A4M_OUT}\" && cp -r dist \"$A4M_OUT\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@phosphor-icons/react": "^2.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.279",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^2.1.9",
    "web-ext": "^8.3.0"
  }
}
