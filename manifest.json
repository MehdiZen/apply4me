{
  "manifest_version": 3,
  "name": "apply4me",
  "version": "0.2.0",
  "description": "Verdict, CV adapté et lettre de motivation sur mesure pour chaque offre d'emploi. Ta clé, tes données, aucun serveur.",
  "browser_specific_settings": {
    "gecko": {
      "id": "apply4me@apply4me.local",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["storage", "activeTab", "debugger"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["extension/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_title": "apply4me",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "extension/options/options.html"
}
